# ===== 大模型服务（阿里云百炼 / DashScope）=====
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1/
DASHSCOPE_MODEL_NAME=qwen-plus
# qwen3 系列是否开启思考模式（点餐场景建议关闭，可显著降低首字延迟与 token 消耗）
DASHSCOPE_ENABLE_THINKING=false
# 关闭 Rerank 时自动降级为「向量 + BM25」融合结果
USE_RERANK=true
# DashScope 重排序模型（gte-rerank 已下线，建议使用 gte-rerank-v2）
RERANK_MODEL=gte-rerank-v2

# ===== 高德地图 =====
AMAP_API_KEY=your-amap-key
RESTAURANT_ADDRESS=湖北省武汉市洪山区光谷广场
MERCHANT_LONGITUDE=114.397745
MERCHANT_LATITUDE=30.466352
# 配送半径，单位：米
DELIVERY_RADIUS=10000
# 1=步行 2=骑电动车 3=驾车
DEFAULT_PATH_MODE=2

# ===== MySQL（与 docker-compose.yml 保持一致）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER_NAME=root
MYSQL_USER_PASSWORD=root
MYSQL_DB_NAME=menu

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== JWT =====
# 生产环境务必替换为随机长字符串
JWT_SECRET_KEY=please-change-me

# ===== LangSmith（可选，用于链路追踪）=====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aimenu

# ===== 服务端口 =====
API_HOST=127.0.0.1
API_PORT=8001
